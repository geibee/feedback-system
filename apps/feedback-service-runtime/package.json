    "@geibee/feedback-connector-sdk": "1.0.0-rc.3",
    "@geibee/feedback-contracts": "1.0.0-rc.3",
    "@geibee/feedback-envelope": "1.0.0-rc.3",
    "@geibee/feedback-gateway": "1.0.0-rc.3",
    "@geibee/feedback-service": "1.0.0-rc.3"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "typescript": "^5.6.3",
    "vitest": "4.1.9"
