    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@geibee/feedback-connector-backlog": "1.0.0-rc.3",
    "@geibee/feedback-connector-jira-cloud": "1.0.0-rc.3",
