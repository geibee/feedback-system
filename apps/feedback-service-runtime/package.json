{
  "name": "@geibee/feedback-service-runtime",
  "version": "1.0.0-rc.3",
  "description": "Feedback Serviceとprovider ConnectorのDBレスproduction composition",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "Dockerfile"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
