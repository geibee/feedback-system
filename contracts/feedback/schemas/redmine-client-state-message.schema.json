{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feedback.example/schemas/redmine-client-state-message.v1.json",
  "title": "RedmineClientStateMessageV1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "profileId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "operationType": {
      "enum": [
        "client-state.follow.get.v1",
        "client-state.follow.set.v1",
        "client-state.follow.list.v1",
        "client-state.intent.get.v1",
        "client-state.intent.set.v1",
        "client-state.draft.get.v1",
        "client-state.draft.set.v1",
        "client-state.clear.v1"
      ]
    },
    "followState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "profileId", "principalScopeHash", "threadId", "issueId", "followed", "lastSeenJournalId", "lastSeenIssueUpdatedOn", "updatedAt"],
      "properties": {
        "schemaVersion": { "const": "1" },
        "profileId": { "$ref": "#/$defs/profileId" },
        "principalScopeHash": { "$ref": "#/$defs/sha256" },
        "threadId": { "$ref": "#/$defs/uuid" },
        "issueId": { "type": "integer", "minimum": 1 },
        "followed": { "type": "boolean" },
        "lastSeenJournalId": { "type": "integer", "minimum": 0 },
        "seenJournalIds": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        },
        "lastSeenIssueUpdatedOn": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "pendingIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "profileId", "threadId", "intentId", "clientDraftHash", "createdAt", "state"],
      "properties": {
        "schemaVersion": { "const": "1" },
        "profileId": { "$ref": "#/$defs/profileId" },
        "threadId": { "$ref": "#/$defs/uuid" },
        "intentId": { "$ref": "#/$defs/uuid" },
        "clientDraftHash": { "$ref": "#/$defs/sha256" },
        "createdAt": { "type": "string", "format": "date-time" },
        "state": { "enum": ["prepared", "uncertain"] }
      }
    },
    "scopedProfilePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "principalScopeHash"],
      "properties": {
        "profileId": { "$ref": "#/$defs/profileId" },
        "principalScopeHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "followGetPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "principalScopeHash", "threadId"],
      "properties": {
        "profileId": { "$ref": "#/$defs/profileId" },
        "principalScopeHash": { "$ref": "#/$defs/sha256" },
        "threadId": { "$ref": "#/$defs/uuid" }
      }
    },
    "followSetPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "state"],
      "properties": {
        "profileId": { "$ref": "#/$defs/profileId" },
        "state": { "$ref": "#/$defs/followState" }
      }
    },
    "followListPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "principalScopeHash"],
      "properties": {
        "profileId": { "$ref": "#/$defs/profileId" },
        "principalScopeHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "intentSetPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "principalScopeHash", "intent"],
      "properties": {
        "profileId": { "$ref": "#/$defs/profileId" },
        "principalScopeHash": { "$ref": "#/$defs/sha256" },
        "intent": { "oneOf": [{ "$ref": "#/$defs/pendingIntent" }, { "type": "null" }] }
      }
    },
    "draftSetPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "principalScopeHash", "draft"],
      "properties": {
        "profileId": { "$ref": "#/$defs/profileId" },
        "principalScopeHash": { "$ref": "#/$defs/sha256" },
        "draft": { "oneOf": [{ "type": "string", "maxLength": 20000 }, { "type": "null" }] }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "type", "payload"],
      "properties": {
        "contractVersion": { "const": "1" },
        "requestId": { "$ref": "#/$defs/uuid" },
        "type": { "$ref": "#/$defs/operationType" },
        "payload": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "client-state.follow.get.v1" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/followGetPayload" } } } },
        { "if": { "properties": { "type": { "const": "client-state.follow.set.v1" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/followSetPayload" } } } },
        { "if": { "properties": { "type": { "const": "client-state.follow.list.v1" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/followListPayload" } } } },
        { "if": { "properties": { "type": { "enum": ["client-state.intent.get.v1", "client-state.draft.get.v1"] } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/scopedProfilePayload" } } } },
        { "if": { "properties": { "type": { "const": "client-state.intent.set.v1" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/intentSetPayload" } } } },
        { "if": { "properties": { "type": { "const": "client-state.draft.set.v1" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/draftSetPayload" } } } },
        { "if": { "properties": { "type": { "const": "client-state.clear.v1" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/followListPayload" } } } }
      ]
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "type", "ok", "result"],
      "properties": {
        "contractVersion": { "const": "1" },
        "requestId": { "$ref": "#/$defs/uuid" },
        "type": { "$ref": "#/$defs/operationType" },
        "ok": { "const": true },
        "result": {}
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "client-state.follow.get.v1" } } }, "then": { "properties": { "result": { "oneOf": [{ "$ref": "#/$defs/followState" }, { "type": "null" }] } } } },
        { "if": { "properties": { "type": { "const": "client-state.follow.list.v1" } } }, "then": { "properties": { "result": { "type": "array", "items": { "$ref": "#/$defs/followState" } } } } },
        { "if": { "properties": { "type": { "const": "client-state.intent.get.v1" } } }, "then": { "properties": { "result": { "oneOf": [{ "$ref": "#/$defs/pendingIntent" }, { "type": "null" }] } } } },
        { "if": { "properties": { "type": { "const": "client-state.draft.get.v1" } } }, "then": { "properties": { "result": { "oneOf": [{ "type": "string", "maxLength": 20000 }, { "type": "null" }] } } } },
        { "if": { "properties": { "type": { "enum": ["client-state.follow.set.v1", "client-state.intent.set.v1", "client-state.draft.set.v1", "client-state.clear.v1"] } } }, "then": { "properties": { "result": { "type": "null" } } } }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "type", "ok", "error"],
      "properties": {
        "contractVersion": { "const": "1" },
        "requestId": { "$ref": "#/$defs/uuid" },
        "type": { "$ref": "#/$defs/operationType" },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable", "upstreamStatus", "requestId"],
          "properties": {
            "code": { "const": "redmine.permission_denied" },
            "message": { "type": "string", "minLength": 1, "maxLength": 500 },
            "retryable": { "const": false },
            "upstreamStatus": { "type": "null" },
            "requestId": { "$ref": "#/$defs/uuid" }
          }
        }
      }
    }
  }
}
