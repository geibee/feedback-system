{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feedback.example/schemas/redmine-extension-profile.v1.json",
  "title": "RedmineExtensionProfilesV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profiles"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "profiles": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "positiveId": { "type": "integer", "minimum": 1 },
    "customFieldIds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threadId",
        "requestHash",
        "applicationKey",
        "environmentKey",
        "externalWorkspaceKey",
        "pageKey",
        "hostResourceKey",
        "perspectiveCode",
        "locator",
        "submittedById",
        "submittedByName",
        "submissionChannel"
      ],
      "properties": {
        "threadId": { "$ref": "#/$defs/positiveId" },
        "requestHash": { "$ref": "#/$defs/positiveId" },
        "applicationKey": { "$ref": "#/$defs/positiveId" },
        "environmentKey": { "$ref": "#/$defs/positiveId" },
        "externalWorkspaceKey": { "$ref": "#/$defs/positiveId" },
        "pageKey": { "$ref": "#/$defs/positiveId" },
        "hostResourceKey": { "$ref": "#/$defs/positiveId" },
        "perspectiveCode": { "$ref": "#/$defs/positiveId" },
        "locator": { "$ref": "#/$defs/positiveId" },
        "submittedById": { "$ref": "#/$defs/positiveId" },
        "submittedByName": { "$ref": "#/$defs/positiveId" },
        "submissionChannel": { "$ref": "#/$defs/positiveId" }
      }
    },
    "perspective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "label"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName",
        "applicationKey",
        "environmentKey",
        "externalWorkspaceKey",
        "hostOrigins",
        "redmineBaseUrl",
        "projectId",
        "trackerId",
        "isPrivate",
        "customFieldIds",
        "perspectives",
        "capture",
        "attachments"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "applicationKey": { "type": "string", "minLength": 1, "maxLength": 100 },
        "environmentKey": { "type": "string", "minLength": 1, "maxLength": 100 },
        "externalWorkspaceKey": { "type": "string", "minLength": 1, "maxLength": 200 },
        "hostOrigins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://(?:[^/@?#]+\\.)*[^/@?#.:]+(?::[0-9]{1,5})?$",
            "maxLength": 253
          }
        },
        "redmineBaseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^/?#@]+(?::[0-9]{1,5})?(?:/(?:[^/?#\\\\]+(?:/[^/?#\\\\]+)*)?)?$",
          "maxLength": 500
        },
        "projectId": { "$ref": "#/$defs/positiveId" },
        "trackerId": { "$ref": "#/$defs/positiveId" },
        "isPrivate": { "type": "boolean" },
        "defaultPriorityId": {
          "anyOf": [{ "$ref": "#/$defs/positiveId" }, { "type": "null" }]
        },
        "customFieldIds": { "$ref": "#/$defs/customFieldIds" },
        "perspectives": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/perspective" }
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "maximumUploadBytes", "contentTypes"],
          "properties": {
            "enabled": { "type": "boolean" },
            "maximumUploadBytes": { "type": "integer", "minimum": 1048576, "maximum": 10485760 },
            "contentTypes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true,
              "items": { "enum": ["image/png", "image/webp"] }
            }
          }
        },
        "attachments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximumInlinePreviewBytes", "maximumDownloadBytes"],
          "properties": {
            "maximumInlinePreviewBytes": { "type": "integer", "minimum": 1048576, "maximum": 10485760 },
            "maximumDownloadBytes": { "type": "integer", "minimum": 1048576, "maximum": 52428800 }
          }
        },
        "showRedmineLink": { "type": "boolean" }
      }
    }
  }
}
