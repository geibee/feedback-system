{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feedback.example/schemas/redmine-operation.v1.json",
  "title": "RedmineOperationMessageV1",
  "oneOf": [
    { "$ref": "#/$defs/profileRequest" },
    { "$ref": "#/$defs/currentUserRequest" },
    { "$ref": "#/$defs/listRequest" },
    { "$ref": "#/$defs/getRequest" },
    { "$ref": "#/$defs/createRequest" },
    { "$ref": "#/$defs/attachmentRequest" },
    { "$ref": "#/$defs/successResponse" },
    { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "profileId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$" },
    "operationType": {
      "enum": [
        "redmine.profile.get.v1",
        "redmine.current-user.get.v1",
        "redmine.thread.list.v1",
        "redmine.thread.get.v1",
        "redmine.thread.create.v1",
        "redmine.attachment.get.v1"
      ]
    },
    "baseRequestProperties": {
      "type": "object",
      "properties": {
        "contractVersion": { "const": "1" },
        "requestId": { "$ref": "#/$defs/uuid" }
      },
      "required": ["contractVersion", "requestId"]
    },
    "profileRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "type", "payload"],
      "properties": {
        "contractVersion": { "const": "1" },
        "requestId": { "$ref": "#/$defs/uuid" },
        "type": { "const": "redmine.profile.get.v1" },
        "payload": { "$ref": "#/$defs/profilePayload" }
      }
    },
    "currentUserRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "type", "payload"],
      "properties": {
        "contractVersion": { "const": "1" },
        "requestId": { "$ref": "#/$defs/uuid" },
        "type": { "const": "redmine.current-user.get.v1" },
        "payload": { "$ref": "#/$defs/profilePayload" }
      }
    },
    "profilePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId"],
      "properties": { "profileId": { "$ref": "#/$defs/profileId" } }
    },
    "resourcePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "resourceRef"],
      "properties": {
        "profileId": { "$ref": "#/$defs/profileId" },
        "resourceRef": { "$ref": "https://feedback.example/schemas/redmine-host-resource-ref.v1.json" }
      }
    },
    "listRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "type", "payload"],
      "properties": {
        "contractVersion": { "const": "1" },
        "requestId": { "$ref": "#/$defs/uuid" },
        "type": { "const": "redmine.thread.list.v1" },
        "payload": { "$ref": "#/$defs/listPayload" }
      }
    },
    "listPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "resourceRef", "pageKey", "sort"],
      "properties": {
        "profileId": { "$ref": "#/$defs/profileId" },
        "resourceRef": { "$ref": "https://feedback.example/schemas/redmine-host-resource-ref.v1.json" },
        "pageKey": { "type": "string", "minLength": 1, "maxLength": 100 },
        "sort": { "enum": ["created_desc", "created_asc", "updated_desc"] },
        "filter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "oneOf": [
                { "enum": ["open", "closed"] },
                { "type": "integer", "minimum": 1 }
              ]
            },
            "perspectiveCode": { "type": "string", "minLength": 1, "maxLength": 100 },
            "assigneeId": { "type": "integer", "minimum": 1 },
            "priorityId": { "type": "integer", "minimum": 1 },
            "q": { "type": "string", "maxLength": 200 }
          }
        },
        "cursor": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "getRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "type", "payload"],
      "properties": {
        "contractVersion": { "const": "1" },
        "requestId": { "$ref": "#/$defs/uuid" },
        "type": { "const": "redmine.thread.get.v1" },
        "payload": { "$ref": "#/$defs/threadPayload" }
      }
    },
    "threadPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "resourceRef", "threadId"],
      "properties": {
        "profileId": { "$ref": "#/$defs/profileId" },
        "resourceRef": { "$ref": "https://feedback.example/schemas/redmine-host-resource-ref.v1.json" },
        "threadId": { "$ref": "#/$defs/uuid" }
      }
    },
    "createRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "type", "payload"],
      "properties": {
        "contractVersion": { "const": "1" },
        "requestId": { "$ref": "#/$defs/uuid" },
        "type": { "const": "redmine.thread.create.v1" },
        "payload": { "$ref": "#/$defs/createPayload" }
      }
    },
    "createPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "resourceRef",
        "threadId",
        "intentId",
        "comment",
        "perspectiveCode",
        "location",
        "target",
        "release",
        "locale",
        "capturedAt",
        "evidence"
      ],
      "properties": {
        "profileId": { "$ref": "#/$defs/profileId" },
        "resourceRef": { "$ref": "https://feedback.example/schemas/redmine-host-resource-ref.v1.json" },
        "threadId": { "$ref": "#/$defs/uuid" },
        "intentId": { "$ref": "#/$defs/uuid" },
        "comment": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "perspectiveCode": { "type": "string", "minLength": 1, "maxLength": 100 },
        "location": { "$ref": "https://feedback.example/schemas/location.v1.json" },
        "target": {
          "oneOf": [{ "$ref": "https://feedback.example/schemas/target.v1.json" }, { "type": "null" }]
        },
        "release": { "type": "string", "minLength": 1, "maxLength": 100 },
        "locale": { "type": "string", "minLength": 2, "maxLength": 35 },
        "capturedAt": { "type": "string", "format": "date-time" },
        "evidence": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "filename",
                "contentType",
                "byteSize",
                "sha256",
                "viewportWidth",
                "viewportHeight",
                "pixelRatio",
                "capturedAt"
              ],
              "properties": {
                "filename": { "type": "string", "maxLength": 80 },
                "contentType": { "enum": ["image/png", "image/webp"] },
                "byteSize": { "type": "integer", "minimum": 1, "maximum": 10485760 },
                "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "viewportWidth": { "type": "integer", "minimum": 1, "maximum": 32768 },
                "viewportHeight": { "type": "integer", "minimum": 1, "maximum": 32768 },
                "pixelRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 16 },
                "capturedAt": { "type": "string", "format": "date-time" }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },
    "attachmentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "type", "payload"],
      "properties": {
        "contractVersion": { "const": "1" },
        "requestId": { "$ref": "#/$defs/uuid" },
        "type": { "const": "redmine.attachment.get.v1" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profileId", "resourceRef", "threadId", "attachmentId"],
          "properties": {
            "profileId": { "$ref": "#/$defs/profileId" },
            "resourceRef": { "$ref": "https://feedback.example/schemas/redmine-host-resource-ref.v1.json" },
            "threadId": { "$ref": "#/$defs/uuid" },
            "attachmentId": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "successResponse": {
      "oneOf": [
        { "$ref": "#/$defs/profileSuccessResponse" },
        { "$ref": "#/$defs/currentUserSuccessResponse" },
        { "$ref": "#/$defs/listSuccessResponse" },
        { "$ref": "#/$defs/getSuccessResponse" },
        { "$ref": "#/$defs/createSuccessResponse" },
        { "$ref": "#/$defs/attachmentSuccessResponse" }
      ]
    },
    "profileSuccessResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "type", "ok", "result"],
      "properties": {
        "contractVersion": { "const": "1" },
        "requestId": { "$ref": "#/$defs/uuid" },
        "type": { "const": "redmine.profile.get.v1" },
        "ok": { "const": true },
        "result": { "$ref": "https://feedback.example/schemas/redmine-model.v1.json#/$defs/profileResult" }
      }
    },
    "currentUserSuccessResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "type", "ok", "result"],
      "properties": {
        "contractVersion": { "const": "1" },
        "requestId": { "$ref": "#/$defs/uuid" },
        "type": { "const": "redmine.current-user.get.v1" },
        "ok": { "const": true },
        "result": { "$ref": "https://feedback.example/schemas/redmine-model.v1.json#/$defs/currentUserResult" }
      }
    },
    "listSuccessResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "type", "ok", "result"],
      "properties": {
        "contractVersion": { "const": "1" },
        "requestId": { "$ref": "#/$defs/uuid" },
        "type": { "const": "redmine.thread.list.v1" },
        "ok": { "const": true },
        "result": { "$ref": "https://feedback.example/schemas/redmine-model.v1.json#/$defs/threadListResult" }
      }
    },
    "getSuccessResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "type", "ok", "result"],
      "properties": {
        "contractVersion": { "const": "1" },
        "requestId": { "$ref": "#/$defs/uuid" },
        "type": { "const": "redmine.thread.get.v1" },
        "ok": { "const": true },
        "result": { "$ref": "https://feedback.example/schemas/redmine-model.v1.json#/$defs/threadResult" }
      }
    },
    "createSuccessResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "type", "ok", "result"],
      "properties": {
        "contractVersion": { "const": "1" },
        "requestId": { "$ref": "#/$defs/uuid" },
        "type": { "const": "redmine.thread.create.v1" },
        "ok": { "const": true },
        "result": { "$ref": "https://feedback.example/schemas/redmine-model.v1.json#/$defs/threadResult" }
      }
    },
    "attachmentSuccessResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "type", "ok", "result"],
      "properties": {
        "contractVersion": { "const": "1" },
        "requestId": { "$ref": "#/$defs/uuid" },
        "type": { "const": "redmine.attachment.get.v1" },
        "ok": { "const": true },
        "result": { "$ref": "https://feedback.example/schemas/redmine-model.v1.json#/$defs/attachmentContentMetadata" }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractVersion", "requestId", "type", "ok", "error"],
      "properties": {
        "contractVersion": { "const": "1" },
        "requestId": { "$ref": "#/$defs/uuid" },
        "type": { "$ref": "#/$defs/operationType" },
        "ok": { "const": false },
        "error": { "$ref": "#/$defs/problem" }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "requestId"],
      "properties": {
        "code": {
          "enum": [
            "redmine.unauthenticated",
            "redmine.invalid_api_key",
            "redmine.permission_denied",
            "redmine.not_found",
            "redmine.duplicate_thread_id",
            "redmine.thread_mismatch",
            "redmine.content_type_rejected",
            "redmine.payload_too_large",
            "redmine.validation_failed",
            "redmine.rate_limited",
            "redmine.unavailable",
            "redmine.contract_invalid",
            "feedback.locator_too_large"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "retryable": { "type": "boolean" },
        "upstreamStatus": {
          "oneOf": [
            { "type": "integer", "minimum": 100, "maximum": 599 },
            { "type": "null" }
          ]
        },
        "requestId": { "$ref": "#/$defs/uuid" }
      }
    }
  }
}
