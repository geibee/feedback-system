{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feedback.example/schemas/redmine-runtime-config.v1.json",
  "title": "Feedback Redmine Runtime Config V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "enabled", "profileId", "gatewayBasePath"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "enabled": { "type": "boolean" },
    "profileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
    },
    "gatewayBasePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^/(?!/)[^\\\\?#@]*$",
      "not": {
        "pattern": "(^|/)(?:\\.|%2[eE]){1,2}(/|$)"
      }
    }
  }
}
