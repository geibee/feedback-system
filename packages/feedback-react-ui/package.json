{
  "name": "@feedback/react-ui",
  "version": "1.0.0-alpha.2",
  "description": "Feedback UI実装間で共有するtarget解決と表示プリミティブ",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@feedback/contracts": "1.0.0-alpha.2",
    "@feedback/core": "1.0.0-alpha.2"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "4.1.9"
  }
}
