{
  "name": "@geibee/redmine-core",
  "version": "1.0.0-alpha.3",
  "description": "Redmineを正本とするFeedbackの共通model・operation・REST client",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./trusted": {
      "types": "./dist/trusted.d.ts",
      "import": "./dist/trusted.js"
    }
  },
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@geibee/contracts": "1.0.0-alpha.3",
    "@geibee/core": "1.0.0-alpha.3"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "4.1.9"
  }
}
