{
  "name": "@feedback/redmine-react",
  "version": "1.0.0-alpha.2",
  "description": "Redmineを正本とするFeedbackのread-only thread UI",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css"
  },
  "dependencies": {
    "@feedback/core": "1.0.0-alpha.2",
    "@feedback/react-ui": "1.0.0-alpha.2",
    "@feedback/dom-capture": "1.0.0-alpha.2",
    "@feedback/redmine-core": "1.0.0-alpha.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0 <20",
    "react-dom": ">=18.0.0 <20"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "4.1.9"
  }
}
