    "revisions": "append-only comment.contentの署名済みrevision Envelope",
    "evidenceBinary": "Backlog issue attachment",
    "attachmentMetadata": "attachmentを関連付けるcomment.contentの署名済みmapping",
    "operationRecoveryMetadata": "issue custom fieldまたはcomment.contentの署名済みmarker"
  },
  "firstThreadWrite": {
