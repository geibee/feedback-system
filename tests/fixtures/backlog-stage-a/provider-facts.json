    "transactionalCommitDocumented": false,
    "requiresLiveConfirmation": true
  },
  "threadLookup": {
    "method": "GET",
    "path": "/api/v2/issues",
    "queryCandidate": {
      "projectId[]": [5],
      "customField_900001": "0191f34b-3a4e-7f61-8ba4-1f4f96774919",
      "count": 100,
      "offset": 0
    },
    "publishedCustomFieldFilterDescription": "Keyword",
    "connectorPostFilter": "responseのText custom field値をthreadIdと完全一致比較し、署名済みEnvelopeとscopeを検証する",
    "zeroHitDecision": "pending",
    "oneHitDecision": "verify-envelope-before-completed",
    "multipleHitDecision": "repair_required",
    "providerUniquenessConstraint": false,
    "readAfterWriteGuaranteeDocumented": false,
    "requiresLiveConfirmation": true
  },
  "operations": {
    "create": {
      "staticGuarantee": "best-effort",
      "bodyAndIntentMarkerSingleWrite": true,
      "providerBackedLookup": "eventual",
      "automaticWriteRetry": false
    },
    "reply": {
      "method": "POST",
      "path": "/api/v2/issues/{issueIdOrKey}/comments",
      "bodyAndIntentMarkerField": "content",
      "staticGuarantee": "best-effort",
      "bodyAndIntentMarkerSingleWrite": true,
      "providerBackedLookup": "eventual",
      "recoveryRead": "既知issueのcommentをminId/maxId、count、orderでpaginationしmarkerを検証する",
      "automaticWriteRetry": false
    },
    "revision": {
      "method": "POST",
      "path": "/api/v2/issues/{issueIdOrKey}/comments",
      "mapping": "既存commentを上書きせずappend-only revision commentを追加する",
      "bodyAndIntentMarkerField": "content",
      "staticGuarantee": "best-effort",
      "bodyAndIntentMarkerSingleWrite": true,
      "providerBackedLookup": "eventual",
      "automaticWriteRetry": false
    },
    "attachmentUpload": {
      "staticGuarantee": "best-effort",
      "steps": [
        "POST /api/v2/space/attachmentで一時attachment IDを得る",
        "POST /api/v2/issues/{issueIdOrKey}/commentsのcontentへ署名済みmapping、attachmentId[]へ一時IDを同梱する"
      ],
      "bodyAndIntentMarkerSingleWrite": false,
      "providerBackedLookup": "none",
      "automaticBinaryRetry": false,
      "signedProviderMapping": false,
      "signedProviderMappingCandidate": "temporary attachment IDを署名し、最終issue attachment IDとの同一性をlive確認する",
      "temporaryFileExpiryWhenNotAttached": "one-hour",
      "minimumDocumentedPlanLimitBytes": 5000000,
      "unknownInitialUploadDecision": "repair_required"
    }
  },
  "provisioning": {
    "requiredCustomFields": [
      "feedback.threadId: Text",
      "feedback.intentId: Text",
      "feedback.requestHash: Text"
    ],
    "readinessChecks": [
      "3 field IDが同じprojectに存在する",
      "3 fieldがtypeId=1のTextである",
      "設定issue typeへ3 fieldが適用される",
      "credential主体がprojectを参照しissueとcommentを追加できる",
      "configured attachment上限がspace plan上限以下である"
