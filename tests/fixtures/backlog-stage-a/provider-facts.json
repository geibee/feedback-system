        "logicalName": "threadId",
        "formName": "customField_900001",
        "customFieldType": "Text"
      },
      {
        "logicalName": "intentId",
        "formName": "customField_900002",
        "customFieldType": "Text"
      },
      {
        "logicalName": "requestHash",
        "formName": "customField_900003",
        "customFieldType": "Text"
      }
    ],
    "requestCandidate": {
      "projectId": 5,
      "summary": "合成Feedback",
      "description": "合成Feedback本文\n\n[feedback-envelope:v2]\n<署名済みEnvelope>\n[/feedback-envelope]",
      "issueTypeId": 2,
      "priorityId": 3,
      "customField_900001": "0191f34b-3a4e-7f61-8ba4-1f4f96774919",
      "customField_900002": "74cb2662-2467-43f4-a506-bebc65e45e8c",
